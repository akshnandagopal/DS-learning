import numpy as np

# Delivery locations
locations = ['A', 'B', 'C', 'D', 'E']
num_locations = len(locations)

# Distance matrix (graph representation)
distance_matrix = np.array([
    [0, 4, 2, 7, 3],  # Distances from A
    [4, 0, 5, 1, 6],  # Distances from B
    [2, 5, 0, 8, 4],  # Distances from C
    [7, 1, 8, 0, 2],  # Distances from D
    [3, 6, 4, 2, 0]   # Distances from E
])

# Q-learning parameters
alpha = 0.1  # Learning rate
gamma = 0.9  # Discount factor
epsilon = 0.2  # Exploration rate
episodes = 1000

# Initialize Q-table
Q_table = np.zeros((num_locations, num_locations))

# Training loop
for episode in range(episodes):
    current_location = np.random.randint(0, num_locations)
    while True:
        # Choose action (next location)
        if np.random.uniform(0, 1) < epsilon:  # Exploration
            next_location = np.random.randint(0, num_locations)
        else:  # Exploitation
            next_location = np.argmax(Q_table[current_location])

        # Reward is negative distance (to minimize cost)
        reward = -distance_matrix[current_location, next_location]

        # Update Q-value
        Q_table[current_location, next_location] += alpha * (
            reward + gamma * np.max(Q_table[next_location]) - Q_table[current_location, next_location]
        )

        # End if episode is complete
        if next_location == current_location:
            break
        current_location = next_location

# Function to compute the optimal path from current to destination
def find_optimal_path(start, destination):
    path = [start]
    current = start
    while current != destination:
        next_location = np.argmax(Q_table[current])
        if next_location in path:  # Prevent loops
            break
        path.append(next_location)
        current = next_location
    return [locations[i] for i in path]

# User input for current location and destination
current_location = input("Enter current location (A, B, C, D, E): ").strip().upper()
destination = input("Enter destination (A, B, C, D, E): ").strip().upper()

if current_location in locations and destination in locations:
    start_idx = locations.index(current_location)
    dest_idx = locations.index(destination)
    optimal_path = find_optimal_path(start_idx, dest_idx)
    print(f"Optimal path from {current_location} to {destination}: {' -> '.join(optimal_path)}")
else:
    print("Invalid location input!")
